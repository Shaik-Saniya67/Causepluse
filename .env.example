# Copy to .env (never commit it) or export these in your shell.
# Optional: enables the AI model for open-ended assistant questions only.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# "file" (default): one local SQLite file. "session": private in-memory data per browser session
# (use this for any public deployment).
CAUSEPULSE_STORAGE=file
# CAUSEPULSE_DB=causepulse.db
